{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["vertical", "sourceRoots"],
  "properties": {
    "$schema": { "type": "string" },
    "vertical": { "type": "string", "minLength": 1 },
    "sourceRoots": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "excludes": { "type": "array", "items": { "type": "string" } },
    "browser": {
      "type": "object",
      "required": ["routes", "coreTasks"],
      "properties": {
        "productionUrl": { "type": "string", "format": "uri" },
        "authenticatedStorageState": { "type": "string" },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "path", "archetype", "primaryAction", "roles", "dataAuthority", "states"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "pattern": "^/" },
              "parent": { "type": ["string", "null"] },
              "archetype": { "type": "string", "minLength": 1 },
              "primaryAction": { "type": ["string", "null"] },
              "roles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "dataAuthority": { "type": "string", "minLength": 1 },
              "auth": { "enum": ["public", "required"] },
              "states": {
                "type": "array",
                "uniqueItems": true,
                "contains": { "const": "loading" },
                "items": { "enum": ["loading", "empty", "error", "populated", "disabled", "permission"] },
                "minItems": 6
              }
            },
            "additionalProperties": false
          }
        },
        "coreTasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "startPath", "steps", "expectedPath"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "startPath": { "type": "string", "pattern": "^/" },
              "steps": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "required": ["role", "name"],
                  "properties": {
                    "role": { "type": "string" },
                    "name": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              },
              "expectedPath": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "legacyBaseline": {
      "type": ["object", "null"],
      "properties": {
        "approvedBy": { "type": "string" },
        "expires": { "type": "string", "format": "date" },
        "maximums": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      },
      "required": ["approvedBy", "expires", "maximums"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
