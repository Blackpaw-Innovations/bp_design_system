    { "id": "DS-05", "name": "Shell and navigation", "blocking": true, "owner": "product-shell" },
    { "id": "DS-06", "name": "Interaction honesty", "blocking": true, "owner": "vertical" },
    { "id": "DS-07", "name": "State completeness", "blocking": true, "owner": "vertical" },
    { "id": "DS-08", "name": "Responsive behavior", "blocking": true, "owner": "product-shell" },
    { "id": "DS-09", "name": "Accessibility", "blocking": true, "owner": "shared" },
    { "id": "DS-10", "name": "Visual regression", "blocking": true, "owner": "vertical" },
