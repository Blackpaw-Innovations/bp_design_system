{
  "name": "@blackpaw/ui",
  "version": "1.0.0",
  "description": "Blackpaw shared design system — tokens, components, Tailwind preset",
  "type": "module",
  "main": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./conformance": "./conformance/experience-rules.json",
    "./conformance/playwright": "./conformance/playwright.mjs",
    "./tokens": "./src/tokens/index.css",
    "./tailwind": "./tailwind.preset.js",
    "./assets/*": "./src/assets/*"
  },
  "scripts": {
    "check:brand": "node scripts/check-brand-system.mjs",
    "check:experience": "node scripts/check-experience-contract.mjs",
    "check:consumer": "node scripts/check-consumer-conformance.mjs",
    "check:brand-assets": "node scripts/check-brand-assets.mjs"
  },
  "files": [
    "src",
    "conformance",
    "scripts",
    "font-library/Urbanist/Urbanist-VariableFont_wght.ttf",
    "font-library/Urbanist/Urbanist-Italic-VariableFont_wght.ttf",
    "font-library/Urbanist/OFL.txt",
    "tailwind.preset.js",
    "tailwind.preset.d.ts"
  ],
  "peerDependencies": {
    "@playwright/test": ">=1.50.0",
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=3",
    "lucide-react": ">=0.300.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "lucide-react": "^0.462.0"
  }
}
