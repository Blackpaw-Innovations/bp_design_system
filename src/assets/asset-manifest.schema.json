{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blackpaw approved asset manifest",
  "type": "object",
  "required": ["version", "approved", "assets"],
  "properties": {
    "version": { "type": "string" },
    "approved": { "type": "string", "format": "date" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "identity", "status", "files", "backgrounds", "recolour"],
        "properties": {
          "id": { "type": "string" },
          "identity": { "enum": ["blackpaw", "hakiqa"] },
          "status": { "enum": ["approved", "deprecated", "experimental"] },
          "files": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "backgrounds": { "type": "array", "items": { "type": "string" } },
          "recolour": { "type": "boolean" },
          "minimumWidthPx": { "type": "number", "minimum": 1 },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
